# -----------------------------------------------------------------------------
# Verdant EcoWitt live soil bridge — example environment
# -----------------------------------------------------------------------------
# Copy to `.env` next to `scripts/ecowitt-live-soil-bridge.ts` and fill in the
# UUIDs / URL / token for YOUR single tent. One bridge process = one tent.
#
# Validate before starting:
#   bun run scripts/ecowitt-live-soil-bridge.ts config validate
# Expected on success:
#   {"event":"config_ok","check":"ecowitt-bridge"}
# On failure the process exits 2 with a stable machine-readable code, e.g.:
#   {"event":"config_error","code":"mixed_tent_channel_map", ...}
#
# Never commit real tent UUIDs, bridge tokens, or ingest URLs.
# -----------------------------------------------------------------------------

# --- Required -----------------------------------------------------------------
# UUID of THIS bridge's single tent. Must match every tent_id in the channel
# map below. Replace with your real tent UUID from Verdant → Settings → Tents.
VERDANT_TENT_ID=11111111-1111-4111-8111-111111111111

# Verdant ingest endpoint. Required for live mode; omit for `--dry-run`.
VERDANT_INGEST_URL=https://<your-project>.functions.supabase.co/sensor-ingest-webhook

# Bridge token minted in Verdant → Settings → Bridge Tokens (scoped to the
# tent above). Required for live mode; omit for `--dry-run`.
VERDANT_BRIDGE_TOKEN=vbt_replace_me

# --- Optional -----------------------------------------------------------------
# Default plant UUID for air/environment metrics that are not per-channel.
# VERDANT_PLANT_ID=33333333-3333-4333-8333-333333333333

# EcoWitt soil channel → tent/plant mapping. Every tent_id MUST equal
# VERDANT_TENT_ID (single-tent enforcement). See:
#   docs/schemas/ecowitt-soil-channel-map.schema.json
#   docs/ecowitt-live-soil-bridge.md
ECOWITT_SOIL_CHANNEL_MAP_JSON={"soilmoisture1":{"tent_id":"11111111-1111-4111-8111-111111111111","plant_id":"33333333-3333-4333-8333-333333333333","label":"Plant A - front"},"soilmoisture2":{"tent_id":"11111111-1111-4111-8111-111111111111","plant_id":"44444444-4444-4444-8444-444444444444","label":"Plant B - back"}}

# --- MQTT broker (local) ------------------------------------------------------
# ECOWITT_MQTT_URL=mqtt://127.0.0.1:1883
# ECOWITT_MQTT_HOST=127.0.0.1
# ECOWITT_MQTT_PORT=1883
# ECOWITT_MQTT_TOPIC=ecowitt/grow
# ECOWITT_MQTT_USERNAME=
# ECOWITT_MQTT_PASSWORD=
