@startuml sensor_ingest_verification_activity
!include ../style.puml

title Sensor ingest verification order\nsensor-ingest-webhook (actual handler spine)

start

if (method == OPTIONS?) then (yes)
  #BBDEFB:204 No Content\nno auth / body / DB;
  stop
else (no)
endif

if (method == POST?) then (no)
  #FFCDD2:405 method_not_allowed;
  stop
else (yes)
endif

:Read Authorization Bearer;
if (missing Bearer?) then (yes)
  #FFCDD2:401 unauthorized;
  stop
else (no)
endif

partition "1. Authenticate (allowJwt: false)" {
  :authenticateBearer\nBRIDGE_PREFIX vbt_\nSHA-256 hash lookup;
  if (auth outcome?) then (bridge_required)
    #FFCDD2:403 bridge_required\n(non-vbt_ / JWT blocked);
    stop
  elseif (token_revoked) then
    #FFCDD2:401 token_revoked;
    stop
  elseif (token_expired) then
    #FFCDD2:401 token_expired;
    stop
  elseif (server_misconfigured /\nauth_lookup_failed) then
    #FFE0B2:503 config or lookup failure;
    stop
  else (kind == bridge)
    :bridge-kind defense-in-depth\n(reject non-bridge auth);
  endif
}

partition "2. Entitlement (separate from token)" {
  :requireLiveSensorEntitlement\n(userId from token row);
  if (entitlement?) then (upgrade_required)
    #FFCDD2:403 upgrade_required;
    stop
  elseif (entitlement_lookup_failed) then
    #FFE0B2:503 entitlement_lookup_failed;
    stop
  else (liveSensors true)
  endif
}

partition "3. Parse and normalize" {
  :parse JSON body;
  if (invalid JSON?) then (yes)
    #FFCDD2:400 invalid_json;
    stop
  else (ok)
  endif
  :normalizeWebhookIngestPayload\n(**request user_id not ownership**);
  if (invalid payload?) then (yes)
    #FFCDD2:400 invalid_payload;
    stop
  else (ok)
  endif
}

partition "4. Tent scope" {
  :tentScopeMatches\n(token tent_id vs payload);
  if (match?) then (no)
    #FFCDD2:403 forbidden_tent;
    stop
  else (yes)
  endif
}

partition "5. Freshness (30-minute server clock)" {
  :classifyIngestTimestampFreshness\nLIVE_INGEST_FRESHNESS_WINDOW_MS\n= 30 * 60 * 1000;
  if (stale?) then (yes)
    #FFE0B2:200 accepted:false\ninserted:0\nreason timestamp_stale\n**zero live writes**;
    stop
  else (fresh)
  endif
}

partition "6. Persistence (service_role only)" {
  :upsert sensor_readings\nowner = auth.userId\nonConflict dedupe key;
  if (insert error?) then (yes)
    #FFCDD2:400 insert_failed\n(sanitized reason);
    stop
  else (ok)
    :compute insertedCount\nand skipped_duplicate;
  endif
}

partition "7. Conditional usage + audit" {
  if (insertedCount > 0?) then (yes)
    :rpc bump_bridge_token_usage;
  else (duplicate only)
    :skip usage bump;
  endif
  :best-effort audit log insert\n(never fails the ingest);
  #C8E6C9:200 success\ninserted / skipped_duplicate;
  stop
}

note right
  **Order is load-bearing.**
  No AI Doctor.
  No alert creation.
  No Action Queue write.
  No automation.
  No device control on this path.

  Runtime DB harness evidence for
  some controls may remain **BLOCKED**
  until zero-skip strict runs succeed —
  do not launder BLOCKED evidence here.
end note

@enduml
