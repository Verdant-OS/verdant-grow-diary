{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && node scripts/scorer-lock.mjs --hook",
            "timeout": 15,
            "statusMessage": "scorer-lock: checking whether this edits a locked check"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && node .claude/skills/verdant-auto-handoff/context-mark.mjs",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
