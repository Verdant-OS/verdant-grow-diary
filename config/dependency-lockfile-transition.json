{
  "schemaVersion": 1,
  "canonicalPackageManager": "bun",
  "canonicalLockfile": "bun.lock",
  "compatibilityLockfile": "package-lock.json",
  "owner": "Verdant dependency security",
  "reason": "package-lock.json remains synchronized while live Vercel, SEO, local setup, and preview verification entrypoints still invoke npm.",
  "reviewBy": "2026-08-25",
  "consumerContracts": [
    {
      "path": "vercel.json",
      "markers": [
        "\"buildCommand\": \"npm run build\",",
        "\"installCommand\": \"npm install\",",
        "\"devCommand\": \"npm run dev\""
      ]
    },
    {
      "path": ".github/workflows/seo-monitoring.yml",
      "markers": ["run: npm ci --no-audit --no-fund || npm install --no-audit --no-fund"]
    },
    {
      "path": "README.md",
      "markers": ["npm install", "npm run dev", "npm run build"]
    },
    {
      "path": ".claude/skills/run-verdant-grow-diary/SKILL.md",
      "markers": ["npm_config_userconfig=$PWD/.npmrc.tmp npm install --no-audit --no-fund"]
    },
    {
      "path": "docs/preview-deployment-verification.md",
      "markers": [
        "| Install command      | `npm install`  |",
        "| Build command        | `npm run build`|",
        "| Dev command          | `npm run dev`  |"
      ]
    }
  ]
}
