# Verdant EcoWitt Windows Testbench — Example env
# -----------------------------------------------
# Copy this file to `.env` and fill in real values locally.
# DO NOT commit `.env`. DO NOT paste real tokens into docs or chat.
#
# All values here are placeholders only — no real project IDs, no real
# tokens, no service-role keys, no anon keys, no access tokens.

VERDANT_INGEST_URL=https://YOUR_PROJECT.supabase.co/functions/v1/sensor-ingest-webhook
VERDANT_BRIDGE_TOKEN=vbt_REPLACE_WITH_REAL_TOKEN

# REQUIRED for forwarding. Must be a real Verdant tent UUID
# (the same UUID stored in the `tents` table — open the tent in the
# Verdant UI and copy its ID).
#
# Forwarding is BLOCKED locally — no request is sent to the ingest
# webhook — if this value is missing, blank, not a UUID, or one of the
# known placeholders. Do NOT use:
#   - display names like "Flower Tent"
#   - demo IDs like tent-1, demo-tent, t1
#   - the all-zero UUID below (it is rejected as a placeholder)
VERDANT_TENT_ID=00000000-0000-0000-0000-000000000000

# Optional: override the listener port (default 8787)
# VERDANT_TESTBENCH_PORT=8787

# Optional: forcing live-source labeling for real EcoWitt gateway traffic.
# Leave unset for local testing. Demo/test payloads stay source="demo".
# VERDANT_FORWARD_MODE=live

# Optional mapped mode. Keep tent-map.json local and never put token values in it.
# Its token_env names refer to local environment variables such as the two below.
# Invalid maps fail at startup; they never fall back silently to a single tent.
# Restart the listener after editing the map.
# ECOWITT_TENT_MAP=tent-map.json
# ECOWITT_FLOWER_BRIDGE_TOKEN=vbt_REPLACE_WITH_REAL_TOKEN
# ECOWITT_VEG_BRIDGE_TOKEN=vbt_REPLACE_WITH_REAL_TOKEN

# Optional durable delivery limits. .spool/ is local, sanitized and gitignored.
# ECOWITT_SPOOL_DIR=.spool
# ECOWITT_SPOOL_MAX_DAYS=7
# ECOWITT_SPOOL_MAX_MB=50
# ECOWITT_REPLAY_INTERVAL_SECONDS=2

# Listener health thresholds (seconds); replay keeps the original event time.
# ECOWITT_QUIET_SECONDS=600
# ECOWITT_FORWARD_FAILURE_SECONDS=600
# ECOWITT_ALERT_INTERVAL_SECONDS=60

# Optional outbound incident alerts. Never paste or commit a real webhook URL.
# Only HTTPS is accepted. No sensor values are included in the incident message.
# ECOWITT_ALERT_WEBHOOK_URL=https://YOUR_ALERT_HOST/YOUR_WEBHOOK
# ECOWITT_ALERT_FORMAT=generic
# Formats: generic, slack, discord, ntfy.
# ntfy JSON uses the server root URL above, with a separate topic below.
# ECOWITT_ALERT_NTFY_TOPIC=YOUR_TOPIC
