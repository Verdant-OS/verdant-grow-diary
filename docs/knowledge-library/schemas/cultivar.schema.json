{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verdantgrowdiary.com/schemas/knowledge/cultivar.schema.json",
  "title": "Verdant cultivar reference page",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "subjectScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subjectType", "accessionId", "batchId", "plantId"],
      "properties": {
        "subjectType": { "enum": ["accession", "batch", "plant"] },
        "accessionId": { "type": ["string", "null"], "minLength": 1 },
        "batchId": { "type": ["string", "null"], "minLength": 1 },
        "plantId": { "type": ["string", "null"], "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": { "subjectType": { "const": "accession" } },
            "required": ["subjectType"]
          },
          "then": {
            "type": "object",
            "properties": {
              "accessionId": { "type": "string", "minLength": 1 },
              "batchId": { "type": "null" },
              "plantId": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": { "subjectType": { "const": "batch" } },
            "required": ["subjectType"]
          },
          "then": {
            "type": "object",
            "properties": {
              "batchId": { "type": "string", "minLength": 1 },
              "plantId": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": { "subjectType": { "const": "plant" } },
            "required": ["subjectType"]
          },
          "then": {
            "type": "object",
            "properties": { "plantId": { "type": "string", "minLength": 1 } }
          }
        }
      ]
    },
    "screeningEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventId",
        "scope",
        "sampleId",
        "target",
        "targetNodeId",
        "result",
        "collectedOn",
        "resultedOn",
        "recordedOn",
        "laboratory",
        "methodId",
        "sourceLinks",
        "supersedesEventId",
        "retestOfEventIds",
        "recordedBy",
        "correctionReason",
        "limitations"
      ],
      "properties": {
        "eventId": { "$ref": "common.schema.json#/$defs/nodeId" },
        "scope": { "$ref": "#/$defs/subjectScope" },
        "sampleId": { "type": ["string", "null"], "minLength": 1 },
        "target": { "type": "string", "minLength": 2 },
        "targetNodeId": {
          "anyOf": [{ "$ref": "common.schema.json#/$defs/nodeId" }, { "type": "null" }]
        },
        "result": { "enum": ["positive", "negative", "inconclusive", "not_tested"] },
        "collectedOn": { "type": ["string", "null"], "format": "date" },
        "resultedOn": { "type": ["string", "null"], "format": "date" },
        "recordedOn": { "type": "string", "format": "date-time" },
        "laboratory": { "type": ["string", "null"] },
        "methodId": {
          "anyOf": [{ "$ref": "common.schema.json#/$defs/nodeId" }, { "type": "null" }]
        },
        "sourceLinks": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/sourceLink" },
          "uniqueItems": true
        },
        "supersedesEventId": {
          "anyOf": [{ "$ref": "common.schema.json#/$defs/nodeId" }, { "type": "null" }]
        },
        "retestOfEventIds": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/nodeId" },
          "uniqueItems": true
        },
        "recordedBy": { "$ref": "common.schema.json#/$defs/nodeId" },
        "correctionReason": { "type": ["string", "null"], "minLength": 12 },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 4 }
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "result": { "enum": ["positive", "negative", "inconclusive"] }
            },
            "required": ["result"]
          },
          "then": {
            "type": "object",
            "properties": {
              "sampleId": { "type": "string", "minLength": 1 },
              "collectedOn": { "type": "string", "format": "date" },
              "resultedOn": { "type": "string", "format": "date" },
              "methodId": { "$ref": "common.schema.json#/$defs/nodeId" },
              "sourceLinks": { "type": "array", "minItems": 1 }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": { "result": { "const": "not_tested" } },
            "required": ["result"]
          },
          "then": {
            "type": "object",
            "properties": {
              "sampleId": { "type": "null" },
              "collectedOn": { "type": "null" },
              "resultedOn": { "type": "null" },
              "methodId": { "type": "null" },
              "sourceLinks": { "type": "array", "maxItems": 0 }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "supersedesEventId": { "$ref": "common.schema.json#/$defs/nodeId" }
            },
            "required": ["supersedesEventId"]
          },
          "then": {
            "type": "object",
            "properties": {
              "correctionReason": { "type": "string", "minLength": 12 }
            }
          }
        }
      ]
    },
    "quarantineEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventId",
        "episodeId",
        "scope",
        "target",
        "action",
        "occurredOn",
        "reason",
        "screeningEventIds",
        "isOverride",
        "recordedBy",
        "sourceLinks",
        "limitations"
      ],
      "properties": {
        "eventId": { "$ref": "common.schema.json#/$defs/nodeId" },
        "episodeId": { "$ref": "common.schema.json#/$defs/nodeId" },
        "scope": { "$ref": "#/$defs/subjectScope" },
        "target": { "type": "string", "minLength": 2 },
        "action": { "enum": ["open", "release", "dispose", "reopen", "override"] },
        "occurredOn": { "type": "string", "format": "date-time" },
        "reason": { "type": "string", "minLength": 8 },
        "screeningEventIds": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/nodeId" },
          "uniqueItems": true
        },
        "isOverride": { "type": "boolean" },
        "recordedBy": { "$ref": "common.schema.json#/$defs/nodeId" },
        "sourceLinks": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/sourceLink" },
          "uniqueItems": true
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 4 }
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": { "action": { "const": "release" } },
            "required": ["action"]
          },
          "then": {
            "type": "object",
            "properties": {
              "isOverride": { "const": false },
              "screeningEventIds": { "type": "array", "minItems": 1 }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": { "action": { "const": "override" } },
            "required": ["action"]
          },
          "then": {
            "type": "object",
            "properties": {
              "isOverride": { "const": true },
              "screeningEventIds": { "type": "array", "maxItems": 0 },
              "reason": { "type": "string", "minLength": 20 }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "action": { "enum": ["open", "release", "dispose", "reopen"] }
            },
            "required": ["action"]
          },
          "then": {
            "type": "object",
            "properties": { "isOverride": { "const": false } }
          }
        }
      ]
    },
    "healthSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "target"],
      "properties": {
        "scope": { "$ref": "#/$defs/subjectScope" },
        "target": { "type": "string", "minLength": 2 }
      }
    },
    "healthDispositionSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "target",
        "screeningState",
        "quarantineState",
        "discordanceState",
        "currentScreeningEventIds",
        "conflictingScreeningEventIds",
        "currentQuarantineEventIds",
        "derivedFromScreeningEventIds",
        "derivedFromQuarantineEventIds",
        "limitations"
      ],
      "properties": {
        "scope": { "$ref": "#/$defs/subjectScope" },
        "target": { "type": "string", "minLength": 2 },
        "screeningState": {
          "enum": ["untested", "negative_scoped", "positive", "inconclusive"]
        },
        "quarantineState": {
          "enum": ["not_started", "open", "released", "disposed", "override"]
        },
        "discordanceState": {
          "enum": ["none", "historical_conflict", "current_conflict", "unknown"]
        },
        "currentScreeningEventIds": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/nodeId" },
          "uniqueItems": true
        },
        "conflictingScreeningEventIds": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/nodeId" },
          "uniqueItems": true
        },
        "currentQuarantineEventIds": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/nodeId" },
          "uniqueItems": true
        },
        "derivedFromScreeningEventIds": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/nodeId" },
          "uniqueItems": true
        },
        "derivedFromQuarantineEventIds": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/nodeId" },
          "uniqueItems": true
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 4 }
        }
      }
    }
  },
  "required": [
    "pageManifest",
    "slug",
    "name",
    "aliases",
    "identity",
    "cultivationContext",
    "claims",
    "phenotypeComparison",
    "missingInformation",
    "sources",
    "editorial",
    "conversion"
  ],
  "properties": {
    "pageManifest": { "$ref": "common.schema.json#/$defs/pageManifest" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 2 },
    "aliases": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cultivarNodeId",
        "breederOrSource",
        "release",
        "lineageClaim",
        "lineageClaimIds",
        "lifeCycle",
        "seedExpression",
        "verificationStatus",
        "identityWarning",
        "provenance"
      ],
      "properties": {
        "cultivarNodeId": { "$ref": "common.schema.json#/$defs/nodeId" },
        "breederOrSource": { "type": ["string", "null"] },
        "release": { "type": ["string", "null"] },
        "lineageClaim": { "type": ["string", "null"] },
        "lineageClaimIds": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/nodeId" },
          "uniqueItems": true
        },
        "lifeCycle": { "enum": ["photoperiod", "autoflower", "unknown"] },
        "seedExpression": { "enum": ["regular", "feminized", "clone_only", "unknown"] },
        "verificationStatus": { "enum": ["sample", "community", "reviewed", "verified"] },
        "identityWarning": { "type": "string", "minLength": 12 },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "materialType",
            "sourceName",
            "acquiredOn",
            "accessionId",
            "seedLotId",
            "motherId",
            "cloneBatchId",
            "generation",
            "phenotypeIds",
            "evidenceSourceIds",
            "healthSubjects",
            "screeningHistory",
            "quarantineHistory",
            "currentHealthDisposition",
            "unknowns"
          ],
          "properties": {
            "materialType": { "enum": ["seed", "clone", "tissue_culture", "unknown"] },
            "sourceName": { "type": ["string", "null"] },
            "acquiredOn": { "type": ["string", "null"], "format": "date" },
            "accessionId": { "type": ["string", "null"] },
            "seedLotId": { "type": ["string", "null"] },
            "motherId": { "type": ["string", "null"] },
            "cloneBatchId": { "type": ["string", "null"] },
            "generation": { "type": ["string", "null"] },
            "phenotypeIds": {
              "type": "array",
              "items": { "$ref": "common.schema.json#/$defs/nodeId" },
              "uniqueItems": true
            },
            "evidenceSourceIds": {
              "type": "array",
              "items": { "$ref": "common.schema.json#/$defs/nodeId" },
              "uniqueItems": true
            },
            "healthSubjects": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/healthSubject" },
              "uniqueItems": true
            },
            "screeningHistory": {
              "type": "array",
              "items": { "$ref": "#/$defs/screeningEvent" },
              "uniqueItems": true
            },
            "quarantineHistory": {
              "type": "array",
              "items": { "$ref": "#/$defs/quarantineEvent" },
              "uniqueItems": true
            },
            "currentHealthDisposition": {
              "type": "object",
              "additionalProperties": false,
              "required": ["derivedOn", "methodId", "subjects", "limitations"],
              "properties": {
                "derivedOn": { "type": "string", "format": "date-time" },
                "methodId": { "const": "method:genetics-health-disposition:v1" },
                "subjects": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "$ref": "#/$defs/healthDispositionSubject" },
                  "uniqueItems": true
                },
                "limitations": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "minLength": 4 }
                }
              }
            },
            "unknowns": { "type": "array", "items": { "type": "string", "minLength": 3 } }
          }
        }
      }
    },
    "cultivationContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "difficulty",
        "height",
        "floweringWindow",
        "stretch",
        "environment",
        "rootZone",
        "training",
        "finishEvidence"
      ],
      "properties": {
        "difficulty": { "enum": ["beginner_friendly", "intermediate", "advanced", "unknown"] },
        "height": { "enum": ["short", "medium", "tall", "variable", "unknown"] },
        "floweringWindow": { "type": ["string", "null"] },
        "stretch": { "type": ["string", "null"] },
        "environment": { "type": "array", "items": { "type": "string" } },
        "rootZone": { "type": "array", "items": { "type": "string" } },
        "training": { "type": "array", "items": { "type": "string" } },
        "finishEvidence": { "type": "array", "items": { "type": "string" } }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/claim" }
    },
    "phenotypeComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phenotypeIds",
        "traitIds",
        "runIds",
        "traits",
        "matchedConditionsRequired",
        "replicationRequired",
        "doNotAssume"
      ],
      "properties": {
        "phenotypeIds": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/nodeId" },
          "uniqueItems": true
        },
        "traitIds": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "common.schema.json#/$defs/nodeId" },
          "uniqueItems": true
        },
        "runIds": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/nodeId" },
          "uniqueItems": true
        },
        "traits": { "type": "array", "minItems": 3, "items": { "type": "string" } },
        "matchedConditionsRequired": { "const": true },
        "replicationRequired": { "const": true },
        "doNotAssume": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "missingInformation": { "type": "array", "items": { "type": "string" } },
    "sources": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "common.schema.json#/$defs/source" }
    },
    "editorial": { "$ref": "common.schema.json#/$defs/editorial" },
    "conversion": { "$ref": "common.schema.json#/$defs/conversion" }
  },
  "allOf": [
    {
      "type": "object",
      "properties": {
        "pageManifest": {
          "type": "object",
          "properties": {
            "metadata": {
              "type": "object",
              "properties": {
                "pageType": { "const": "cultivar" },
                "pageFamily": { "const": "entity" }
              }
            },
            "graph": {
              "type": "object",
              "properties": {
                "node": {
                  "type": "object",
                  "properties": { "type": { "const": "Cultivar" } }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "identity": {
            "type": "object",
            "properties": { "verificationStatus": { "const": "verified" } },
            "required": ["verificationStatus"]
          }
        },
        "required": ["identity"]
      },
      "then": {
        "type": "object",
        "properties": {
          "identity": {
            "type": "object",
            "properties": {
              "lineageClaimIds": { "type": "array", "minItems": 1 },
              "provenance": {
                "type": "object",
                "properties": {
                  "evidenceSourceIds": { "type": "array", "minItems": 1 }
                }
              }
            }
          }
        }
      }
    },
    { "$ref": "common.schema.json#/$defs/pageSafetyReviewGate" }
  ]
}
